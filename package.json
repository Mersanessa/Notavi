{
  "name": "notavi",
  "private": true,
  "version": "1.4.0",
  "description": "A private, local-first novel library and reader.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && NOTAVI_BASE=/notavi/ vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "icons": "node scripts/make-icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-haptics": "^2.4.2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "d3-force": "^3.0.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tauri-plugin-tts-api": "^0.2.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
